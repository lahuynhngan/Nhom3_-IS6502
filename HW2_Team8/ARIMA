99Z","shell.execute_reply":"2026-05-06T10:14:12.067767Z"}},"outputs":[{"name":"stdout","text":"✅ Lag feature function defined\n","output_type":"stream"}],"execution_count":31},{"id":"1bc3f587","cell_type":"code","source":"# ARIMA + Ridge - Retail Dataset\nprint(\"=\"*60)\nprint(\"🔧 ARIMA + Ridge - Retail Dataset\")\nprint(\"=\"*60)\n\n# Create lag features for train\ny_all_retail = np.concatenate([train_retail['Units_Sold'].values, val_retail['Units_Sold'].values])\nX_train_retail, y_train_ridge_retail, df_train_ridge = make_lag_features(y_all_retail, dropna=True)\n\n# Fit Ridge on train+val lag features\nscaler_retail = StandardScaler()\nX_train_scaled = scaler_retail.fit_transform(X_train_retail)\n\nridge_retail = Ridge(alpha=1.0, random_state=RANDOM_SEED)\nridge_retail.fit(X_train_scaled, y_train_ridge_retail)\n\n# Create lag features for test\ny_all_for_test = np.concatenate([y_all_retail, test_retail['Units_Sold'].values])\nX_full, y_full, _ = make_lag_features(y_all_for_test, dropna=True)\n\n# Get test predictions from Ridge\nridge_test_start_idx = len(X_train_retail)  # Where new data starts\nX_test_ridge = X_full[ridge_test_start_idx:]\nX_test_scaled = scaler_retail.transform(X_test_ridge)\n\nridge_retail_test_pred = np.clip(ridge_retail.predict(X_test_scaled), 0, None)\n\nridge_retail_test_metrics = evaluate_forecast(test_retail['Units_Sold'].values, ridge_retail_test_pred, prefix='test')\n\nprint(f\"✅ Ridge test metrics: {ridge_retail_test_metrics}\")\nprint(f\"   Feature count: {X_train_retail.shape[1]}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-06T10:14:12.070636Z","iopub.execute_input":"2026-05-06T10:14:12.070925Z","iopub.status.idle":"2026-05-06T10:14:12.105696Z","shell.execute_reply.started":"2026-05-06T10:14:12.070895Z","shell.execute_reply":"2026-05-06T10:14:12.104990Z"}},"outputs":[{"name":"stdout","text":"============================================================\n🔧 ARIMA + Ridge - Retail Dataset\n==================